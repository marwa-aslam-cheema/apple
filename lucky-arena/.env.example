# Required in production: a PostgreSQL connection string (Neon, Supabase, RDS, Render...).
# Leave unset in development to use a local file database (PGlite) in .data/
DATABASE_URL=

# Required in production: long random string used to sign session cookies (openssl rand -base64 32)
SESSION_SECRET=

# Public address of the site, used for link previews when someone shares it (for example https://luckyarena.example).
SITE_URL=

# Optional: seeds the first admin account on an empty database.
# In development defaults to admin@luckyarena.test / admin12345 if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phone notifications (optional). Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
