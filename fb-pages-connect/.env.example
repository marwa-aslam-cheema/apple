# Meta Developer App (developers.facebook.com > App settings > Basic)
FB_APP_ID=
FB_APP_SECRET=
# Must also be listed under Valid OAuth Redirect URIs in your Facebook Login settings
FB_REDIRECT_URI=http://localhost:3100/auth/callback
# Only for "Facebook Login for Business": the Configuration ID (leave empty otherwise)
FB_CONFIG_ID=
# Shown on the Privacy Policy, Terms and Data Deletion pages (required for App Review)
BUSINESS_NAME=
CONTACT_EMAIL=
# Public https address once the app is deployed (used in the data deletion callback response)
PUBLIC_URL=
PORT=3100
