# Meta Developer App ki settings (developers.facebook.com > App settings > Basic)
FB_APP_ID=
FB_APP_SECRET=
# Facebook Login > Settings > Valid OAuth Redirect URIs mein yehi URL daalna hai
FB_REDIRECT_URI=http://localhost:3000/auth/callback
# Sirf "Facebook Login for Business" ke liye: Configurations mein bani Configuration ID (warna khali chhodein)
FB_CONFIG_ID=
PORT=3000
